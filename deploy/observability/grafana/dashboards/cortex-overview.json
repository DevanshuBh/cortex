{
 "uid": "cortex-overview",
 "title": "CORTEX overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Questions answered / min by outcome",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(cortex_answers_total[5m])) * 60",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Answer time p50 / p95",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(cortex_task_duration_seconds_bucket{kind=\"ask\"}[10m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(cortex_task_duration_seconds_bucket{kind=\"ask\"}[10m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Queue depth",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cortex_queue_depth",
     "legendFormat": "{{queue}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Model calls / min by tier and step",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (tier, step) (rate(cortex_llm_calls_total[5m])) * 60",
     "legendFormat": "{{tier}} {{step}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Model errors and throttling",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (throttled) (rate(cortex_llm_errors_total[5m]))",
     "legendFormat": "throttled={{throttled}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Notional cost per question (median)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(cortex_query_cost_usd_bucket[1h])))",
     "legendFormat": "median"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retrieval stage latency p95",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(cortex_retrieval_latency_seconds_bucket[10m])))",
     "legendFormat": "{{stage}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Loop-guard stops",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (increase(cortex_loop_guard_triggers_total[1h]))",
     "legendFormat": "{{reason}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Nightly Recall@10",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "cortex_eval_recall_at_10",
     "legendFormat": "{{config}}"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Real-user Web Vitals p75",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.75, sum by (le, name) (rate(cortex_web_vitals_bucket[1h])))",
     "legendFormat": "{{name}}"
    }
   ]
  }
 ],
 "tags": [
  "cortex"
 ]
}